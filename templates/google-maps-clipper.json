{
	"schemaVersion": "0.1.0",
	"name": "Google Maps",
	"behavior": "create",
	"noteContentFormat": "",
	"properties": [
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "aliases",
			"value": "{{selector:div[role='main']?aria-label}}, {{selector:div[role='main'] h2.fontBodyMedium}}",
			"type": "multitext"
		},
		{
			"name": "related",
			"value": "[[Places]], [[Google Maps]]",
			"type": "multitext"
		},
		{
			"name": "Links",
			"value": "https://www.google.com/maps?ftid={{url|split:\"!1s\"|slice:1|first|split:\"!\"|first}}",
			"type": "multitext"
		},
		{
			"name": "coordinates",
			"value": "{{url|split:\"!3d\"|slice:1|first|split:\"!\"|first}}, {{url|split:\"!4d\"|slice:1|first|split:\"!\"|first}}",
			"type": "multitext"
		},
		{
			"name": "plus_code",
			"value": "{{selector:button[data-item-id='oloc']?aria-label|split:\":\"|last|trim}}",
			"type": "text"
		},
		{
			"name": "address",
			"value": "{{selector:button[aria-label^='Address: ']?aria-label|split:\"Address: \"|last|trim}}",
			"type": "text"
		},
		{
			"name": "city",
			"value": "{{selector:button[data-item-id='oloc']?aria-label|split:\"+\"|last|split:\" \"|slice:1|join:\" \"|split:\",\"|first|trim}}",
			"type": "text"
		},
		{
			"name": "country",
			"value": "[[🚧 todo]]",
			"type": "text"
		},
		{
			"name": "rating",
			"value": "",
			"type": "number"
		},
		{
			"name": "description",
			"value": "",
			"type": "text"
		}
	],
	"triggers": [
		"https://www.google.com/maps/place/"
	],
	"noteNameFormat": "{% set placeName = selector:div[role='main']?aria-label %}{% set placeCategory = selector:div[role='main'] h2.fontBodyMedium %}{% set placeCity = selector:button[data-item-id='oloc']?aria-label|split:\"+\"|last|split:\" \"|slice:1|join:\" \"|split:\",\"|first|trim %}{{placeName}} {% if placeCategory %}- {{placeCategory}} {% endif %}{% if placeCity %}— {{placeCity}}{% endif %}",
	"path": "Places"
}
