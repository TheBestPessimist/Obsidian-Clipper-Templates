{
	"schemaVersion": "0.1.0",
	"name": "Google Maps",
	"behavior": "create",
	"noteContentFormat": "",
	"properties": [
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "aliases",
			"value": "{{selector:div[role='main']?aria-label}}, {{selector:div[role='main'] h2.fontBodyMedium}}",
			"type": "multitext"
		},
		{
			"name": "related",
			"value": "[[Places]], [[Google Maps]]",
			"type": "multitext"
		},
		{
			"name": "Links",
			"value": "[\"{{url}}\"]",
			"type": "multitext"
		},
		{
			"name": "coordinates",
			"value": "{{url|split:\\\"/@\\\"|slice:1|split:\\\",\\\"|slice:0,2}}",
			"type": "multitext"
		},
		{
			"name": "address",
			"value": "{{selector:button[aria-label^='Address: ']?aria-label|split:\\\"Address: \\\"|last|trim}}",
			"type": "text"
		},
		{
			"name": "rating",
			"value": "",
			"type": "number"
		},
		{
			"name": "description",
			"value": "",
			"type": "text"
		}
	],
	"triggers": [
		"https://www.google.com/maps/place/"
	],
	"noteNameFormat": "{{selector:div[role='main']?aria-label}} {% if selector:div[role='main'] h2.fontBodyMedium %}- {{selector:div[role='main'] h2.fontBodyMedium}}{% endif %}",
	"path": "Places"
}
