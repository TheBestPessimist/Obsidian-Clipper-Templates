{
  "schemaVersion": "0.1.0",
  "name": "Simon Willison",
  "behavior": "create",
  "noteContentFormat": "\n{{selectorHtml:.entry.entryPage|remove_html:(\".mobile-date-eyebrow,.entryFooter,.edit-page-link\")|markdown}}",
  "properties": [
    {
      "name": "created",
      "value": "{{date}}",
      "type": "date"
    },
    {
      "name": "aliases",
      "value": "",
      "type": "multitext"
    },
    {
      "name": "author",
      "value": "{{author|wikilink}}",
      "type": "multitext"
    },
    {
      "name": "Links",
      "value": "{{url}}",
      "type": "multitext"
    },
    {
      "name": "published",
      "value": "{{selector:.entryFooter|split:\"Posted \"|last|split:\" at \"|first|date:(\"YYYY-MM-DD\",\"Do MMMM YYYY\")}}",
      "type": "date"
    },
    {
      "name": "related",
      "value": "[[Clippings]]{% for tagUrl in selector:.item-tag?href %}, [[{{tagUrl|split:\"/tags/\"|last|replace:\"/\":\"\"}}]]{% endfor %}",
      "type": "multitext"
    }
  ],
  "triggers": [
    "https://simonwillison.net/"
  ],
  "noteNameFormat": "{{title}} — Simon Willison",
  "path": "Clippings"
}
