ifference} in ranking\",\"ratings_export_button_text\":\"Export ratings\",\"ratings_index_pagination_max_records_exceeded\":\"To view all your ratings, export the complete history.\",\"ratings_index_pagination_max_records_exceeded_not_list_owner\":\"Hmm, it looks like we couldn't find that rating. Try updating your filters and sort options.\",\"ratings_privacy_prompt_title\":\"Ratings history privacy\",\"ratings_privacy_public_with_reviews\":\"Public with reviews\",\"ratings_privacy_semi_public\":\"Semi-public\",\"ratings_privacy_semi_public_help_text\":\"Only shown with reviews\",\"recentlyViewed_card_ariaLabel_navigateName\":\"Navigation to {itemName} Name Page\",\"recentlyViewed_card_ariaLabel_navigateTitle\":\"Navigation to {itemName} Title Page\",\"recentlyViewed_card_ariaLabel_searchFor\":\"Search for {itemName}\",\"recentlyViewed_section_action_clearAll\":\"Clear all\",\"recentlyViewed_section_action_learnMore\":\"Learn more.\",\"recentlyViewed_section_label_needCookies\":\"Please enable browser cookies to use this feature.\",\"recentlyViewed_section_label_noneRecentlyViewed\":\"You have no recently viewed pages\",\"recentlyViewed_section_label_recentlyViewed\":\"Recently viewed\",\"registration_changeloginsecurityexternal_button\":\"Amazon login and security\",\"registration_changeloginsecurityexternal_description\":\"Your IMDb login is your Amazon account. Update your account details on Amazon.\",\"registration_changeloginsecurityexternal_title\":\"Change your account settings\",\"related_list_page_empty_text\":\"There are no lists related to {entityName} yet. Start the trend by creating one!\",\"related_lists_page__hero_description_name\":\"This page presents a consolidated catalog of lists directly connected to the Name page you were exploring, offering a comprehensive overview of related information.\",\"related_lists_page__hero_description_title\":\"This page presents a consolidated catalog of lists directly connected to the Title page you were exploring, offering a comprehensive overview of related information.\",\"related_lists_page__page_title\":\"Lists Related to {entityName}\",\"returning_to_tv_description\":\"From your Watchlist, ratings, and popular shows\",\"returning_to_tv_new_season\":\"New: Season {seasonNumber}\",\"returning_to_tv_title\":\"Current \\u0026 upcoming TV shows\",\"returning_to_tv_watch_options\":\"Watch options\",\"reviewShoveler_review_author_rating\":\"Author rating is {authorRating}\",\"review_single_meta_description\":\"This page focuses on one review for {title} from {authorName}\",\"review_single_meta_title\":\"{authorName}'s review of {title}\",\"review_single_subpage_title\":\"Review by {authorName}\",\"reviews_featured_unauth_featured_title\":\"Featured reviews\",\"reviews_featured_unauth_sign_in_header\":\"Sign in to see all reviews\",\"reviews_featured_unauth_sign_in_sub_header\":\"There are {count} more user reviews for this title. Sign in to read them all.\",\"reviews_featured_unauth_signpost\":\"{count, plural, one {Featured review} other {Featured reviews}}\",\"reviews_reg_gate_open_app_link\":\"Open in the IMDb App\",\"reviews_reg_gate_sign_in_button\":\"Sign in to IMDb\",\"reviews_reg_gate_sign_in_context\":\"This extra step helps us keep IMDb's reviews a space for genuine, human voices.\",\"reviews_reg_gate_sign_in_explanatory_text\":\"We're updating how you access user reviews on IMDb which will require you to sign in to view, write, edit, or report reviews. This extra step is part of our ongoing effort to keep IMDb's reviews a space for genuine, human voices.\",\"reviews_reg_gate_sign_in_prompt_header\":\"Sign in to access user reviews\",\"reviews_reg_gate_sign_in_prompt_sub_header\":\"See opinions from other fans, or write your own review.\",\"rich_text_editor_post_body_placeholder\":\"Share your thoughts (optional)\",\"rich_text_editor_post_body_placeholder_required\":\"Share your thoughts\",\"rich_text_editor_post_title_aria\":\"Post title\",\"rich_text_editor_post_