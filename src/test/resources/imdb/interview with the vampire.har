t', {\n                element: {\n                    slotId: 'LoadFooterJS',\n                    type: 'service-call'\n                }\n            });\n            csaLatencyPlugin('mark', 'clickToBodyBegin', 1793443625803);\n        }\n    })</script><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"tconst\":\"tt0110148\",\"aboveTheFoldData\":{\"id\":\"tt0110148\",\"productionStatus\":{\"currentProductionStage\":{\"id\":\"released\",\"text\":\"Released\",\"__typename\":\"ProductionStage\"},\"productionStatusHistory\":[{\"status\":{\"id\":\"released\",\"text\":\"Released\",\"__typename\":\"ProductionStatus\"},\"__typename\":\"ProductionStatusHistory\"}],\"restriction\":null,\"__typename\":\"ProductionStatusDetails\"},\"externalLinks\":{\"total\":155,\"__typename\":\"ExternalLinkConnection\"},\"metacritic\":{\"metascore\":{\"score\":62,\"__typename\":\"Metascore\"},\"__typename\":\"Metacritic\"},\"keywords\":{\"total\":514,\"edges\":[{\"node\":{\"text\":\"monster as victim\",\"__typename\":\"TitleKeyword\"},\"__typename\":\"TitleKeywordEdge\"},{\"node\":{\"text\":\"vampire\",\"__typename\":\"TitleKeyword\"},\"__typename\":\"TitleKeywordEdge\"},{\"node\":{\"text\":\"18th century\",\"__typename\":\"TitleKeyword\"},\"__typename\":\"TitleKeywordEdge\"},{\"node\":{\"text\":\"betrayal\",\"__typename\":\"TitleKeyword\"},\"__typename\":\"TitleKeywordEdge\"},{\"node\":{\"text\":\"interview\",\"__typename\":\"TitleKeyword\"},\"__typename\":\"TitleKeywordEdge\"}],\"__typename\":\"TitleKeywordConnection\"},\"credits\":{\"total\":589,\"__typename\":\"CreditConnection\"},\"engagementStatistics\":{\"watchlistStatistics\":{\"displayableCount\":{\"text\":\"Added by 764K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"WatchlistStatistics\"},\"__typename\":\"EngagementStatistics\"},\"titleText\":{\"text\":\"Interview with the Vampire: The Vampire Chronicles\",\"__typename\":\"TitleText\"},\"titleType\":{\"displayableProperty\":{\"value\":{\"plainText\":\"\",\"__typename\":\"Markdown\"},\"__typename\":\"DisplayableTitleTypeProperty\"},\"text\":\"Movie\",\"id\":\"movie\",\"isSeries\":false,\"isEpisode\":false,\"categories\":[{\"value\":\"movie\",\"__typename\":\"TitleTypeCategory\"}],\"canHaveEpisodes\":false,\"__typename\":\"TitleType\"},\"originalTitleText\":{\"text\":\"Interview with the Vampire: The Vampire Chronicles\",\"__typename\":\"TitleText\"},\"certificate\":{\"rating\":\"R\",\"__typename\":\"Certificate\"},\"releaseYear\":{\"year\":1994,\"endYear\":null,\"__typename\":\"YearRange\"},\"releaseDate\":{\"day\":11,\"month\":11,\"year\":1994,\"country\":{\"text\":\"United States\",\"__typename\":\"LocalizedDisplayableCountry\"},\"__typename\":\"ReleaseDate\"},\"runtime\":{\"seconds\":7380,\"displayableProperty\":{\"value\":{\"plainText\":\"2h 3m\",\"__typename\":\"Markdown\"},\"__typename\":\"DisplayableTitleRuntimeProperty\"},\"__typename\":\"Runtime\"},\"originalRuntime\":{\"seconds\":7380,\"displayableProperty\":{\"value\":{\"plainText\":\"2h 3m\",\"__typename\":\"Markdown\"},\"__typename\":\"DisplayableTitleRuntimeProperty\"},\"__typename\":\"Runtime\"},\"canRate\":{\"isRatable\":true,\"__typename\":\"CanRate\"},\"ratingsSummary\":{\"aggregateRating\":7.5,\"voteCount\":383119,\"__typename\":\"RatingsSummary\"},\"meterRanking\":{\"currentRank\":708,\"rankChange\":{\"changeDirection\":\"DOWN\",\"difference\":66,\"__typename\":\"MeterRankChange\"},\"__typename\":\"TitleMeterRanking\"},\"series\":null,\"isAdult\":false,\"genres\":{\"genres\":[{\"text\":\"Drama\",\"id\":\"Drama\",\"__typename\":\"Genre\"},{\"text\":\"Fantasy\",\"id\":\"Fantasy\",\"__typename\":\"Genre\"},{\"text\":\"Horror\",\"id\":\"Horror\",\"__typename\":\"Genre\"}],\"__typename\":\"Genres\"},\"interests\":{\"edges\":[{\"node\":{\"id\":\"in0000316\",\"primaryText\":{\"text\":\"Anne Rice's Immortal Universe\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"Born from Anne Rice's gothic novels of vampires and witches, this supernatural franchise explores immortality, desire, and moral ruin across centuries of human history. Its adaptations bring Rice's lush mythology to screen, treating the eternal and the monstrous as vehicles for questions of identity, memory, and what it costs to live forever.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BNDFmNDM5YjEtMDc3Yi00NDZhLWFjMDMtMThlMjYyNWU4MjVkXkEyXkFqcGc@._V1_.jpg\",\"width\":6000,\"height\":4000,\"caption\":{\"plainText\":\"Jacob Anderson in Interview with the Vampire (2022)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":null,\"secondaryText\":{\"text\":\"Franchise\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000095\",\"primaryText\":{\"text\":\"Dark Fantasy\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The dark fantasy subgenre features elements of fantasy combined with darker and more macabre themes. These stories often involves a blend of supernatural elements, magical realms, and horror-inspired elements, creating a unique and often unsettling atmosphere, distinct from traditional high fantasy or light-hearted fairy tales.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BZjdhOTYwZTktNzUwOS00MWJiLWI0ZDgtN2ZhNzhlZTUzNmM4XkEyXkFqcGc@._V1_.jpg\",\"width\":1400,\"height\":952,\"caption\":{\"plainText\":\"Doug Jones and Ivana Baquero in Pan's Labyrinth (2006)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 40.5K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Subgenre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000077\",\"primaryText\":{\"text\":\"Epic\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The epic subgenre features grand and sweeping stories often set against significant historical, cultural, or societal backdrops. Epic dramas are characterized by their scope, scale, and often lengthy runtime, as they aim to capture the grandeur of human experiences, events, and emotions.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BZmZkMzI4YWEtMmIxMi00ZDA2LTk3MDMtNzVmOGQ1NzI5OTU2XkEyXkFqcGc@._V1_.jpg\",\"width\":1200,\"height\":900,\"caption\":{\"plainText\":\"Orson Welles in Citizen Kane (1941)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 13.7K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Subgenre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000114\",\"primaryText\":{\"text\":\"Psychological Horror\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The psychological horror subgenre features psychological tension, fear, and suspense to evoke feelings of dread and unease in the audience. Rather than relying solely on graphic violence or jump scares, psychological horror focuses on the psychological and emotional experiences of characters, often exploring their inner fears, anxieties, and perceptions.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMTUxMjEzNzE1NF5BMl5BanBnXkFtZTgwNDYwNjUzMTI@._V1_.jpg\",\"width\":2048,\"height\":1151,\"caption\":{\"plainText\":\"Daniel Kaluuya in Get Out (2017)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 54.9K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Subgenre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000099\",\"primaryText\":{\"text\":\"Supernatural Fantasy\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The supernatural fantasy subgenre features stories that blend fantastical elements with the supernatural, often involving interactions between the human world and realms inhabited by supernatural beings, spirits, or forces.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BYmE5MDc4ZmMtNzI5Mi00MmIyLTkwZjYtNGFjNjYwMzhhNmVmXkEyXkFqcGc@._V1_.jpg\",\"width\":2000,\"height\":1315,\"caption\":{\"plainText\":\"Dan Aykroyd, Bill Murray, Harold Ramis, and Ernie Hudson in Ghostbusters (1984)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 18.6K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Subgenre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000117\",\"primaryText\":{\"text\":\"Supernatural Horror\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The supernatural horror subgenre features paranormal and supernatural elements as sources of fear and terror. In supernatural horror stories, the focus is on entities, forces, or occurrences that go beyond the natural world and challenge the laws of reality, including ghosts, demons, witches, curses, haunted houses, possession, and other phenomena that are unexplainable.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BNWEwY2NjZjItMzA5Zi00ZDU0LTljOWItOGZiODJhMGE5MTIyXkEyXkFqcGc@._V1_.jpg\",\"width\":1920,\"height\":1080,\"caption\":{\"plainText\":\"Daveigh Chase in The Ring (2002)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 36.9K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Subgenre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000090\",\"primaryText\":{\"text\":\"Tragedy\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The tragedy subgenre features stories characterized by sorrowful events, unfortunate circumstances, and often a sense of inevitable and irreversible loss or downfall. They evoke deep emotions and can explore themes of human suffering, fate, moral dilemmas, and the complexity of human nature.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMTc4MTQxMTIwMl5BMl5BanBnXkFtZTgwNzM2NzE4OTE@._V1_.jpg\",\"width\":2048,\"height\":1365,\"caption\":{\"plainText\":\"Casey Affleck and Michelle Williams in Manchester by the Sea (2016)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 10.0K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Subgenre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000119\",\"primaryText\":{\"text\":\"Vampire Horror\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The vampire horror subgenre features the depiction of vampires, supernatural creatures who sustain themselves by consuming the blood of the living, as central figures of fear and fascination. Vampire horror can use vampirism as a metaphor for various themes, such as addiction, the fear of death, and the loss of humanity.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMjE0NjY4OTEwNl5BMl5BanBnXkFtZTgwMTE0OTIwMjE@._V1_.jpg\",\"width\":4775,\"height\":3075,\"caption\":{\"plainText\":\"Tom Cruise and Indra Ové in Interview with the Vampire: The Vampire Chronicles (1994)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 11.0K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Subgenre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000076\",\"primaryText\":{\"text\":\"Drama\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The drama genre is a broad category that features stories portraying human experiences, emotions, conflicts, and relationships in a realistic and emotionally impactful way. Dramas delve into the complexities of human life, often exploring themes of love, loss, morality, societal issues, personal growth, with the aim to evoke an emotional response from the audience by presenting relatable and thought-provoking stories.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BN2MxZmYzMDItYzNkMS00YWY1LWIzNDktNTI3YTQxMGNjZjEzXkEyXkFqcGc@._V1_.jpg\",\"width\":5760,\"height\":3840,\"caption\":{\"plainText\":\"Mahershala Ali and Alex R. Hibbert in Moonlight (2016)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 113K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Genre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000098\",\"primaryText\":{\"text\":\"Fantasy\",\"__typename\":\"InterestText\"},\"description\":{\"value\":{\"plainText\":\"The fantasy genre features imaginative and often magical worlds, characters, and events. It explores realms beyond the boundaries of reality, featuring elements such as magic, mythical creatures, supernatural powers, and fantastical settings. These stories can take place in entirely fictional worlds or blend fantastical elements with real-world settings.\",\"__typename\":\"Markdown\"},\"__typename\":\"LocalizedMarkdown\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMTc5NTU2NDQ5Ml5BMl5BanBnXkFtZTcwMDIxMjk2Mw@@._V1_.jpg\",\"width\":1826,\"height\":1033,\"caption\":{\"plainText\":\"Elijah Wood in The Lord of the Rings: The Fellowship of the Ring (2001)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"engagementStatistics\":{\"followerStatistics\":{\"displayableCount\":{\"text\":\"Added by 52.2K users\",\"__typename\":\"LocalizedDisplayableCount\"},\"__typename\":\"FollowerStatistics\"},\"__typename\":\"EngagementStatistics\"},\"secondaryText\":{\"text\":\"Genre\",\"__typename\":\"InterestText\"},\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"}],\"__typename\":\"InterestConnection\"},\"plot\":{\"plotText\":{\"plainText\":\"A vampire tells his epic life story: love, betrayal, loneliness, and hunger.\",\"__typename\":\"Markdown\"},\"language\":{\"id\":\"en-US\",\"__typename\":\"DisplayableLanguage\"},\"machineTranslatedText\":{\"language\":{\"id\":\"en-US\"},\"value\":{\"plainText\":\"A vampire tells his epic life story: love, betrayal, loneliness, and hunger.\",\"__typename\":\"Markdown\"},\"isMachineTranslation\":false,\"__typename\":\"MachineTranslatedMarkdown\"},\"__typename\":\"Plot\"},\"plotContributionLink\":{\"url\":\"https://contribute.imdb.com/updates?update=tt0110148:outlines.add.1.locale~en-US\",\"__typename\":\"ContributionLink\"},\"primaryImage\":{\"id\":\"rm1724055552\",\"width\":1001,\"height\":1500,\"url\":\"https://m.media-amazon.com/images/M/MV5BYzJlN2NiZDQtZmI4NC00ZWFiLWFmMTUtMWM4ODVlOGFlODY1XkEyXkFqcGc@._V1_.jpg\",\"caption\":{\"plainText\":\"Tom Cruise and Kirsten Dunst in Interview with the Vampire: The Vampire Chronicles (1994)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"images\":{\"total\":157,\"edges\":[{\"node\":{\"id\":\"rm573754368\",\"__typename\":\"Image\"},\"__typename\":\"ImageEdge\"}],\"__typename\":\"ImageConnection\"},\"videos\":{\"total\":4,\"__typename\":\"TitleRelatedVideosConnection\"},\"primaryVideos\":{\"edges\":[{\"node\":{\"id\":\"vi244449561\",\"createdDate\":\"2008-04-11T14:45:40Z\",\"isMature\":false,\"runtime\":{\"value\":149,\"__typename\":\"VideoRuntime\"},\"name\":{\"value\":\"Interview with the Vampire\",\"language\":\"en\",\"__typename\":\"LocalizedString\"},\"description\":{\"value\":\"Trailer for Interview with the Vampire\",\"language\":\"en\",\"__typename\":\"LocalizedString\"},\"timedTextTracks\":[],\"recommendedTimedTextTrack\":null,\"thumbnail\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BYWJmMzQ4ZGUtYjdiZS00MDQxLWIxYjEtZmE2M2VlNTk1ZjQ4XkEyXkFqcGdeQXVyNzU1NzE3NTg@._V1_.jpg\",\"height\":360,\"width\":480,\"__typename\":\"Thumbnail\"},\"primaryTitle\":{\"id\":\"tt0110148\",\"titleText\":{\"text\":\"Interview with the Vampire: The Vampir