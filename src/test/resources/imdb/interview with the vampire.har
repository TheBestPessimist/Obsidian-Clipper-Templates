in.\",\"subscriptions_unsubscribe_error_title\":\"Unsubscribe Error\",\"subscriptions_unsubscribe_success_message\":\"You have been successfully unsubscribed\",\"subscriptions_unsubscribe_success_title\":\"Unsubscribed\",\"suggested_tv_from_ratings_recent\":\"Recent\",\"suggested_tv_from_ratings_switch_aria\":\"Switch to show {value} titles\",\"suggested_tv_from_ratings_upcoming\":\"Upcoming\",\"symphony_chart_widget_hide_rated_checkbox_label\":\"Hide rated\",\"titleRecommendationPrompt_attributionHeading\":\"Because of your interest in\",\"title_alternateVersions_pageTitle\":\"Alternate versions\",\"title_details_director\":\"{count, plural, one {Director} other {Directors}}\",\"title_edit_credit_row_edit_cta\":\"Edit\",\"title_edit_feedback_fab_close_label\":\"Close feedback prompt\",\"title_edit_feedback_fab_label\":\"Give feedback on the new title editing experience\",\"title_edit_feedback_hon_question\":\"What do you think of the new Title Edit experience?\",\"title_edit_feedback_prompt_body\":\"You're using IMDb's new title editing experience. Tell us what you think; your feedback helps us make it better. Prefer the Classic Editor? You can opt-out anytime.\",\"title_edit_feedback_prompt_close\":\"Close\",\"title_edit_feedback_prompt_opt_out\":\"Opt-out\",\"title_edit_feedback_prompt_provide_feedback\":\"Provide feedback\",\"title_edit_hero_edit_aka\":\"Edit title AKA\",\"title_edit_hero_edit_original_title\":\"Edit original title\",\"title_edit_hero_view_title\":\"Edit\",\"title_edit_spv_section_add_aria\":\"Add {sectionLabel}\",\"title_edit_spv_section_list_heading\":\"{sectionLabel} list\",\"title_edit_spv_title_view_heading\":\"Title view\",\"title_edit_submit_coachmark_body\":\"Use this button to submit your contribution to IMDb\",\"title_edit_submit_coachmark_close\":\"Close\",\"title_edit_submit_coachmark_dialog_label\":\"{target}. {heading}\",\"title_edit_submit_coachmark_heading\":\"Ready to submit?\",\"title_edit_submit_coachmark_ok\":\"OK\",\"title_edit_tour_aria_label\":\"Title Edit page feature tour\",\"title_edit_tour_close\":\"Close tour\",\"title_edit_tour_got_it\":\"Got it\",\"title_edit_tour_next\":\"Next\",\"title_edit_tour_step_indicator\":\"{current} of {total}\",\"title_edit_tour_step_one_body\":\"This area lets you quickly navigate all the title data types. You can search and favorite types for quick access.\",\"title_edit_tour_step_one_heading\":\"Welcome to the Title Edit Page\",\"title_edit_tour_step_three_body\":\"Your pending changes will appear here. When you are ready to submit them, click the Submit button.\",\"title_edit_tour_step_three_heading\":\"Pending changes\",\"title_edit_tour_step_two_body\":\"This section shows all the title data. Click the {editIcon} icon to edit an item. A form will open where you can draft your changes.\",\"title_edit_tour_step_two_heading\":\"Making edits\",\"title_edit_view_add_plot_outline\":\"Add outline\",\"title_edit_view_add_plot_summary\":\"Add summary\",\"title_edit_view_badges_add\":\"{count, plural, one {# Add} other {# Adds}}\",\"title_edit_view_badges_edit\":\"{count, plural, one {# Edit} other {# Edits}}\",\"title_edit_view_badges_issue\":\"{count, plural, one {# Issue} other {# Issues}}\",\"title_edit_view_badges_new_name\":\"New Name\",\"title_edit_view_badges_removal\":\"{count, plural, one {# Removal} other {# Removals}}\",\"title_edit_view_basket_already_submitted_snack\":\"This basket has already been submitted\",\"title_edit_view_basket_attribution_original\":\"The original contributor\",\"title_edit_view_basket_attribution_original_help\":\"The changes will be submitted under the original contributor's account and added to their contribution history.\",\"title_edit_view_basket_attribution_self\":\"Yourself\",\"title_edit_view_basket_attribution_self_copy_help\":\"A new contribution will be created under your account. The customer's saved contribution will remain saved.\",\"title_edit_view_basket_attribution_submit\":\"Submit\",\"title_edit_view_basket_attribution_title\":\"Who do you want to submit these changes as?\",\"title_edit_view_basket_copy_ineligible_snack\":\"This contribution can't be copied\",\"title_edit_view_basket_copy_recovery_body\":\"Your copy was created. Load it to review and submit your changes.\",\"title_edit_view_basket_header_clear_all\":\"Clear all changes\",\"title_edit_view_basket_header_clear_all_confirm_body\":\"This will permanently remove all your proposed changes for this title.\",\"title_edit_view_basket_header_clear_all_confirm_body_warning\":\"You won't be able to recover them.\",\"title_edit_view_basket_header_clear_all_confirm_cta\":\"Clear all changes\",\"title_edit_view_basket_header_clear_all_confirm_title\":\"Clear all proposed changes?\",\"title_edit_view_basket_header_clear_all_continue\":\"Continue working\",\"title_edit_view_basket_header_more_options\":\"More options\",\"title_edit_view_basket_header_none\":\"None\",\"title_edit_view_basket_header_save_changes\":\"Save changes\",\"title_edit_view_basket_header_submit\":\"Submit changes to IMDb\",\"title_edit_view_basket_header_total\":\"Total proposed changes\",\"title_edit_view_basket_item_discard\":\"Discard\",\"title_edit_view_basket_item_discard_aria\":\"Discard changes for {title}\",\"title_edit_view_basket_item_discard_confirm_body\":\"This will permanently remove your proposed change(s).\",\"title_edit_view_basket_item_discard_confirm_body_warning\":\"You won't be able to recover them.\",\"title_edit_view_basket_item_discard_confirm_cta\":\"Discard change(s)\",\"title_edit_view_basket_item_discard_confirm_title\":\"Discard change(s)?\",\"title_edit_view_basket_item_discard_snack\":\"Discarded!\",\"title_edit_view_basket_item_edit_aria\":\"Edit {title}\",\"title_edit_view_basket_item_no_longer_exists\":\"This item no longer exists, so this change won't be applied.\",\"title_edit_view_basket_item_reason\":\"Reason\",\"title_edit_view_basket_item_tag_issue\":\"Issue\",\"title_edit_view_basket_item_tag_r