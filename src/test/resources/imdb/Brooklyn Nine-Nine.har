:\"Steve Carell, Jenna Fischer, Rainn Wilson, John Krasinski, and B.J. Novak in The Office (2005)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"releaseYear\":{\"year\":2005,\"endYear\":2013,\"__typename\":\"YearRange\"},\"ratingsSummary\":{\"aggregateRating\":9,\"voteCount\":823690,\"__typename\":\"RatingsSummary\"},\"runtime\":{\"seconds\":1320,\"__typename\":\"Runtime\"},\"certificate\":{\"rating\":\"TV-14\",\"__typename\":\"Certificate\"},\"canRate\":{\"isRatable\":true,\"__typename\":\"CanRate\"},\"titleGenres\":{\"genres\":[{\"genre\":{\"text\":\"Comedy\",\"__typename\":\"GenreItem\"},\"__typename\":\"TitleGenre\"}],\"__typename\":\"TitleGenres\"},\"__typename\":\"Title\"},\"__typename\":\"MoreLikeThisEdge\"},{\"node\":{\"id\":\"tt1266020\",\"titleText\":{\"text\":\"Parks and Recreation\",\"__typename\":\"TitleText\"},\"titleType\":{\"id\":\"tvSeries\",\"text\":\"TV Series\",\"canHaveEpisodes\":true,\"displayableProperty\":{\"value\":{\"plainText\":\"TV Series\",\"__typename\":\"Markdown\"},\"__typename\":\"DisplayableTitleTypeProperty\"},\"__typename\":\"TitleType\"},\"originalTitleText\":{\"text\":\"Parks and Recreation\",\"__typename\":\"TitleText\"},\"primaryImage\":{\"id\":\"rm239932929\",\"width\":680,\"height\":1000,\"url\":\"https://m.media-amazon.com/images/M/MV5BNDlhMzAwNTAtNTk2NS00MTdkLWE3ZWYtMDU0MTFiYmU2ZTc0XkEyXkFqcGc@._V1_.jpg\",\"caption\":{\"plainText\":\"Adam Scott, Rashida Jones, Jim O'Heir, Nick Offerman, Amy Poehler, Chris Pratt, Retta, Aziz Ansari, and Aubrey Plaza in Parks and Recreation (2009)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"releaseYear\":{\"year\":2009,\"endYear\":2015,\"__typename\":\"YearRange\"},\"ratingsSummary\":{\"aggregateRating\":8.6,\"voteCount\":312902,\"__typename\":\"RatingsSummary\"},\"runtime\":{\"seconds\":1320,\"__typename\":\"Runtime\"},\"certificate\":{\"rating\":\"TV-14\",\"__typename\":\"Certificate\"},\"canRate\":{\"isRatable\":true,\"__typename\":\"CanRate\"},\"titleGenres\":{