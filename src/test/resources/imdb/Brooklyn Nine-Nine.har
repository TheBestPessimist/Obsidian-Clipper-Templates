V2\"},{\"name\":{\"id\":\"nm3715867\",\"nameText\":{\"text\":\"Stephanie Beatriz\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm0187719\",\"nameText\":{\"text\":\"Terry Crews\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm0303073\",\"nameText\":{\"text\":\"Melissa Fumero\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"}],\"__typename\":\"PrincipalCreditsForGrouping\"}],\"crewV2\":[{\"grouping\":{\"groupingId\":\"amzn1.imdb.concept.name_credit_group.85198717-6c2d-481e-93a5-47858774bcce\",\"__typename\":\"CreditGrouping\"},\"credits\":[{\"name\":{\"id\":\"nm0329634\",\"nameText\":{\"text\":\"Dan Goor\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm1321658\",\"nameText\":{\"text\":\"Michael Schur\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"}],\"__typename\":\"PrincipalCreditsForGrouping\"}],\"production\":{\"edges\":[{\"node\":{\"company\":{\"id\":\"co0447669\",\"companyText\":{\"text\":\"Fremulon\",\"__typename\":\"CompanyText\"},\"__typename\":\"Company\"},\"__typename\":\"CompanyCredit\"},\"__typename\":\"CompanyCreditEdge\"},{\"node\":{\"company\":{\"id\":\"co0447670\",\"companyText\":{\"text\":\"Dr. Goor Productions\",\"__typename\":\"CompanyText\"},\"__typename\":\"Company\"},\"__typename\":\"CompanyCredit\"},\"__typename\":\"CompanyCreditEdge\"},{\"node\":{\"company\":{\"id\":\"co0070636\",\"companyText\":{\"text\":\"3 Arts Entertainment\",\"__typename\":\"CompanyText\"},\"__typename\":\"Company\"},\"__typename\":\"CompanyCredit\"},\"__typename\":\"CompanyCreditEdge\"}],\"__typename\":\"CompanyCreditConnection\"},\"featuredReviews\":{\"edges\":[{\"node\":{\"author\":{\"nickName\":\"montez7679\",\"__typename\":\"UserProfile\"},\"summary\":{\"originalText\":\"I can't understand who wouldn't find this show fantastic\",\"__typename\":\"ReviewSummary\"},\"text\":{\"originalText\":{\"plainText\":\"I respect that different people have different tastes in music, clothes, women, movies etc...but if you are saying that this show is bad I really feel like your sense of humor is lacking. I'm a detective for one of the largest police departments in the country and I will advise everyone that doesn't realize it but this show is closer to how real police go about their day than any of those CSI, or garbage procedural shows. Cops do all that stuff all day...pranking each other, busting balls, trying to have a little fun. The job gets a little heavy sometimes so if we didn't have some fun it would be long days. This show is hilarious and perfectly timed retorts by Braugher and Crews are classic. Its the low key lines that make I hilarious...the over the top cheap laughs are somethkng all shows have to do to please the masses...who are stupid. Pay attention to the underlying comedy...its priceless.......\\\"Terry does love yogurt\\\"\",\"__typename\":\"Markdown\"},\"__typename\":\"ReviewText\"},\"authorRating\":9,\"submissionDate\":\"2013-10-19\",\"__typename\":\"Review\"},\"__typename\":\"ReviewEdge\"}],\"__typename\":\"ReviewsConnection\"},\"__typename\":\"Title\"},\"mainColumnData\":{\"id\":\"tt2467372\",\"wins\":{\"total\":19,\"__typename\":\"AwardNominationConnection\"},\"nominationsExcludeWins\":{\"total\":129,\"__typename\":\"AwardNominationConnection\"},\"prestigiousAwardSummary\":{\"nominations\":9,\"wins\":2,\"award\":{\"text\":\"Primetime Emmy\",\"id\":\"aw0002214\",\"event\":{\"id\":\"ev0000223\",\"__typename\":\"AwardsEvent\"},\"__typename\":\"AwardDetails\"},\"__typename\":\"PrestigiousAwardSummary\"},\"ratingsSummary\":{\"topRanking\":{\"id\":\"topRatedTv:tt2467372:en_US\",\"text\":{\"value\":\"Top Rated TV\",\"__typename\":\"LocalizedString\"},\"rank\":334,\"__typename\":\"TopRanking\"},\"__typename\":\"RatingsSummary\",\"aggregateRating\":8.4,\"voteCount\":413261,\"notificati