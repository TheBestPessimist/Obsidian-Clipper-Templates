":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm3627424\",\"nameText\":{\"text\":\"Takahiro Miura\",\"__typename\":\"NameText\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMTQ1MDY5NTk1OV5BMl5BanBnXkFtZTgwOTAzMDE3NjE@._V1_.jpg\",\"width\":2808,\"height\":1872,\"__typename\":\"Image\"},\"__typename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.a9ab2a8b-9153-4edb-a27a-7c2346830d77\",\"text\":\"Actor\",\"__typename\":\"CreditCategory\"},\"attributes\":null,\"characters\":{\"edges\":[{\"node\":{\"name\":\"Teppei Takeno\",\"__typename\":\"Character\"},\"__typename\":\"CharacterEdge\"}],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm12004747\",\"nameText\":{\"text\":\"Ai Mikami\",\"__typename\":\"NameText\"},\"primaryImage\":null,\"__typename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.7f6d81aa-23aa-4503-844d-38201eb08761\",\"text\":\"Actress\",\"__typename\":\"CreditCategory\"},\"attributes\":null,\"characters\":{\"edges\":[{\"node\":{\"name\":\"Fujikoma\",\"__typename\":\"Character\"},\"__typename\":\"CharacterEdge\"}],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm13318127\",\"nameText\":{\"text\":\