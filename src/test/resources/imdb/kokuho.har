pename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.a9ab2a8b-9153-4edb-a27a-7c2346830d77\",\"text\":\"Actor\",\"__typename\":\"CreditCategory\"},\"attributes\":null,\"characters\":{\"edges\":[{\"node\":{\"name\":\"Gongoro Tachibana\",\"__typename\":\"Character\"},\"__typename\":\"CharacterEdge\"}],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm0793562\",\"nameText\":{\"text\":\"Kyûsaku Shimada\",\"__typename\":\"NameText\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BNDg3M2M5NmYtOGZmNC00MjY1LWFlZmItZjUyNmIyM2VkYjdiXkEyXkFqcGc@._V1_.jpg\",\"width\":400,\"height\":480,\"__typename\":\"Image\"},\"__typename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.a9ab2a8b-9153-4edb-a27a-7c2346830d77\",\"text\":\"Actor\",\"__typename\":\"CreditCategory\"},\"attributes\":null,\"characters\":{\"edges\":[{\"node\":{\"name\":\"Umeki\",\"__typename\":\"Character\"},\"__typename\":\"CharacterEdge\"}],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm5445698\",\"nameText\":{\"text\":\"Emma Miyazawa\",\"__typename\":\"NameText\"},\"primaryImage\":null,\"__typename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.7f6d81aa-23aa-4503-844d-38201eb08761\",\"text\":\"Actress\",\"__typename\":\"CreditCategory\"},\"attributes\":null,\"characters\":{\"edges\":[{\"node\":{\"name\":\"Matsu Tachibana\",\"__typename\":\"Character\"},\"__typename\":\"CharacterEdge\"}],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm0849032\",\"nameText\":{\"text\":\"Min Tanaka\",\"__typename\":\"NameText\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMjE1MjM3MDM2N15BMl5BanBnXkFtZTgwNTk3OTE4MDE@._V1_.jpg\",\"width\":2048,\"height\":852,\"__typename\":\"Image\"},\"__typename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.a9ab2a8b-9153-4edb-a27a-7c2346830d77\",\"text\":\"Actor\",\"__typename\":\"CreditCategory\"},\"attributes\":null,\"characters\":{\"edges\":[{\"node\":{\"name\":\"Mangiku Onogawa\",\"__typename\":\"Character\"},\"__typename\":\"CharacterEdge\"}],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm0913822\",\"nameText\":{\"text\":\"Ken Watanabe\",\"__typename\":\"NameText\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMTQzMTUzNjc4Nl5BMl5BanBnXkFtZTcwMTUyODU2Mw@@._V1_.jpg\",\"width\":277,\"height\":400,\"__typename\":\"Image\"},\"__typename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.a9ab2a8b-9153-4edb-a27a-7c2346830d77\",\"text\":\"Actor\",\"__typename\":\"CreditCategory\"},\"attributes\":null,\"characters\":{\"edges\":[{\"node\":{\"name\":\"Hanjiro Hanai\",\"__typename\":\"Character\"},\"__typename\":\"CharacterEdge\"}],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm5992836\",\"nameText\":{\"text\":\"Kazunari Yanagitani\",\"__typename\":\"NameText\"},\"primaryImage\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BZDE4NjViMTEtOGMzYi00M2RmLTlmYTktYjY3ZDZmMGFjOGRhXkEyXkFqcGc@._V1_CR104,1,376,563_.jpg\",\"width\":376,\"height\":563,\"__typename\":\"Image\"},\"__typename\":\"Name\"},\"creditedRoles\":{\"edges\":[{\"node\":{\"category\":{\"categoryId\":\"amzn1.imdb.concept.name_credit_category.a9ab2a8b-9153-4edb-a27a-7c2346830d77\",\"text\":\"Actor\",\"__typename\":\"CreditCategory\"},\"attributes\":[{\"text\":\"voice\",\"__typename\":\"MiscellaneousCreditAttribute\"}],\"characters\":{\"edges\":[],\"__typename\":\"CharacterConnection\"},\"__typename\":\"CreditedRole\"},\"__typename\":\"CreditedRoleEdge\"}],\"__typename\":\"CreditedRoleConnection\"},\"episodeCredits\":{\"total\":0,\"yearRange\":null,\"__typename\":\"EpisodeCreditConnection\"},\"__typename\":\"CreditV2\"}],\"__typename\":\"PrincipalCreditsForGrouping\"}],\"crewV2\":[{\"totalCredits\":1,\"grouping\":{\"groupingId\":\"amzn1.imdb.concept.name_credit_category.ace5cb4c-8708-4238-9542-04641e7c8171\",\"text\":\"Director\",\"__typename\":\"CreditGrouping\"},\"credits\":[{\"name\":{\"id\":\"nm0498212\",\"nameText\":{\"text\":\"Sang-il Lee\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"}],\"__typename\":\"PrincipalCreditsForGrouping\"},{\"totalCredits\":2,\"grouping\":{\"groupingId\":\"amzn1.imdb.concept.name_credit_category.c84ecaff-add5-4f2e-81db-102a41881fe3\",\"text\":\"Writers\",\"__typename\":\"CreditGrouping\"},\"credits\":[{\"name\":{\"id\":\"nm0645766\",\"nameText\":{\"text\":\"Satoko Okudera\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"},{\"name\":{\"id\":\"nm2398252\",\"nameText\":{\"text\":\"Shûichi Yoshida\",\"__typename\":\"NameText\"},\"__typename\":\"Name\"},\"__typename\":\"CreditV2\"}],\"__typename\":\"PrincipalCreditsForGrouping\"}],\"titleText\":{\"text\":\"Kokuho\",\"__typename\":\"TitleText\"},\"originalTitleText\":{\"text\":\"Kokuhô\",\"__typename\":\"TitleText\"},\"canRate\":{\"isRatable\":true,\"__typename\":\"CanRate\"},\"reviews\":{\"total\":39,\"__typename\":\"ReviewsConnection\"},\"aggregateRatingsBreakdown\":{\"histogram\":{\"histogramValues\":[{\"rating\":1,\"voteCount\":45,\"__typename\":\"HistogramValues\"},{\"rating\":2,\"voteCount\":19,\"__typename\":\"HistogramValues\"},{\"rating\":3,\"voteCount\":38,\"__typename\":\"HistogramValues\"},{\"rating\":4,\"voteCount\":57,\"__typename\":\"HistogramValues\"},{\"rating\":5,\"voteCount\":154,\"__typename\":\"HistogramValues\"},{\"rating\":6,\"voteCount\":353,\"__typename\":\"HistogramValues\"},{\"rating\":7,\"voteCount\":920,\"__typename\":\"HistogramValues\"},{\"rating\":8,\"voteCount\":1291,\"__typename\":\"HistogramValues\"},{\"rating\":9,\"voteCount\":807,\"__typename\":\"HistogramValues\"},{\"rating\":10,\"voteCount\":585,\"__typename\":\"HistogramValues\"}],\"__typename\":\"Histogram\"},\"__typename\":\"AggregateRatingsBreakdown\"},\"featuredReviews\":{\"edges\":[{\"node\":{\"id\":\"rw10722626\",\"author\":{\"userId\":\"ur153959139\",\"username\":{\"text\":\"HannahHarte666\",\"__typename\":\"UserProfileUsername\"},\"primaryImage\":{\"image\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BMmNjM2IxMjEtYWVjNC00YjZjLWJiYWUtMjI4ZDZlMzZjYzI0XkEyXkFqcGc@._V1_.jpg\",\"height\":769,\"width\":769,\"caption\":{\"plainText\":\"Avatar\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"__typename\":\"UserProfileImage\"},\"__typename\":\"UserProfile\"},\"summary\":{\"originalText\":\"Best film of 2025\",\"__typename\":\"ReviewSummary\"},\"text\":{\"originalText\":{\"plaidHtml\":\"It\\u0026#39;s only August but I\\u0026#39;m calling it. This is the film of the year, for me. My favourite genre is horror, but truly great cinema is truly great cinema, regardless of genre. The seats at Lumière for NZIFF were packed, yet despite a three hour run time, no one moved a muscle. Most audiences will get up \\u0026amp; down in a film that barely covers 80 minutes. The performances are some of the best I\\u0026#39;ve ever seen, \\u0026amp; even if you aren\\u0026#39;t familiar with the art of Kabuki theatre, you would have a stone heart not be moved by the work. I had to bite my hand to prevent audible sobbing \\u0026amp; was left shaking, mascara running down my face, in absolute awe of what I had witnessed. The Oscars are not good enough for this film.\",\"__typename\":\"Markdown\"},\"__typename\":\"ReviewText\"},\"title\":{\"id\":\"tt35231039\",\"__typename\":\"Title\"},\"authorRating\":10,\"spoiler\":false,\"__typename\":\"Review\"},\"__typename\":\"ReviewEdge\"},{\"node\":{\"id\":\"rw10583136\",\"author\":{\"userId\":\"ur183344555\",\"username\":{\"text\":\"rysz_\",\"__typename\":\"UserProfileUsername\"},\"primaryImage\":null,\"__typename\":\"UserProfile\"},\"summary\":{\"originalText\":\"A Tribute to the Sprits of Kabuki and Ninkyo Passed Down through generations.\",\"__typename\":\"ReviewSummary\"},\"text\":{\"originalText\":{\"plaidHtml\":\"\\u0026quot;Kokuho\\u0026quot; is one of the most powerful Japanese films I\\u0026#39;ve ever seen in recent years. It is beautiful work that blends traditional art, moral tension, and emotional depth into something unforgettable.\\u003cbr/\\u003e\\u003cbr/\\u003eThe sound design is particularly mesmerizing. Since Kabuki is inherently tied to rhythmic and percussive elements like taiko, the audio plays a critical role. The film pulls me into its world with every beat and breath. That said, some parts felt slightly over-exaggerated.\\u003cbr/\\u003e\\u003cbr/\\u003eThe storytelling was fascinating. The two protagonists have a deep and complex relationship. Their bond is tested by differences in their backgrounds, but they both share the same core value which is Ninkyo, the traditional Japanese code of chivalry. This shared principle-passed down through generation-gives the film emotional weight and cultural resonance.\\u003cbr/\\u003e\\u003cbr/\\u003eHowever, the narrative occasionally jumps across time with little warning. These transitions can be confusing, and I sometimes found myself wondering what had happened.\\u003cbr/\\u003e\\u003cbr/\\u003eVisually, the film is breathtaking. While I usually appreciate balanced, still compositions like Stanley Kubrick and Akira Kurosawa, I was captivated by how the Kabuki scenes were shot. The narrow focus and dynamic camerawork brought the dace sequences to life with elegance and intensity, highlighting their beauty and power.\\u003cbr/\\u003e\\u003cbr/\\u003eIn short, \\u0026quot;Kokuho\\u0026quot; is rare masterpiece. It reawakened my appreciation for Japanese cinema. I highly recommend it to anyone interested in traditional Japanese culture, powerful cinematic art in general.\",\"__typename\":\"Markdown\"},\"__typename\":\"ReviewText\"},\"title\":{\"id\":\"tt35231039\",\"__typename\":\"Title\"},\"authorRating\":8,\"spoiler\":false,\"__typename\":\"Review\"},\"__typename\":\"ReviewEdge\"},{\"node\":{\"id\":\"rw10982044\",\"author\":{\"userId\":\"ur90346975\",\"username\":{\"text\":\"shannonangelica-50593\",\"__typename\":\"UserProfileUsername\"},\"primaryImage\":null,\"__typename\":\"UserProfile\"},\"summary\":{\"originalText\":\"My personal favorite movie of the last decade\",\"__typename\":\"ReviewSummary\"},\"text\":{\"originalText\":{\"plaidHtml\":\"Kokuho is three hours and I didn\\u0026#39;t feel it. Fifty years of a kabuki actor\\u0026#39;s life, and every scene earns its place. The performances are stunning, the cinematography pulls you onto the stage, and the character work is extraordinary. You think you understand who you\\u0026#39;re watching, then the film reveals the cost of his \\u0026quot;greatness.\\u0026quot; I\\u0026#39;ve never seen anything like it.\",\"__typename\":\"Markdown\"},\"__typename\":\"ReviewText\"},\"title\":{\"id\":\"tt35231039\",\"__typename\":\"Title\"},\"authorRating\":9,\"spoiler\":false,\"__typename\":\"Review\"},\"__typename\":\"ReviewEdge\"},{\"node\":{\"id\":\"rw10899497\",\"author\":{\"userId\":\"ur23965049\",\"username\":{\"text\":\"flcntk3-856-986017\",\"__typename\":\"UserProfileUsername\"},\"primaryImage\":{\"image\":{\"url\":\"https://m.media-amazon.com/images/M/MV5BNDA0YTZhMjItYzliNi00MDE5LTllZjMtYzRiMzVjZGFkNGQ5XkEyXkFqcGc@._V1_.jpg\",\"height\":229,\"width\":229,\"caption\":{\"plainText\":\"Avatar\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"__typename\":\"UserProfileImage\"},\"__typename\":\"UserProfile\"},\"summary\":{\"originalText\":\"National Treasure\",\"__typename\":\"ReviewSummary\"},\"text\":{\"originalText\":{\"plaidHtml\":\"For a person who doesn\\u0026#39;t know one iota of the art of Kabuki nor any Japanese for that matter, I was mesmerized and engrossed for three hours by KOKUHO, which is a life story about a boy who was taken into the renown Kabuki house of Kamigata, and trained there along with the son of the house owner and master of the craft in the art of Kabuki. Through trial and tribulation of life, he rode the highs and lows of success and misfortune, with tradition and bloodline legacy as obstacles that broke the bond of brotherhood, but which also helped to rejoin that kinship of his later. This boy Kikuo, who is now a man, and because of his talents and devotion to the art, has finally become a \\u0026quot;Kokuho\\u0026quot;, a National Treasure. This is a human story on an epic scale based on a novel by Shuichi Yoshida. The beauty of the film is in the elegance of its storytelling. The distillation of something down to its essence and extract the purity of its beauty is a unique form of Japanese aesthetics. This film has done that masterfully. And you can find that in the unadorned, yet beautifully framed tight camera works. Or in the explosive magic that comes from the formality of the theatrics of Kabuki. However, there is one thing I must mention, and which might have passed unnoticed because it works under the epidermis of consciousness of most and that is the music scoring. The music scoring is sublime. As an example of its power, the music for the scene where Kikuo took to the stage by anointment circumventing the protocol of legitimacy and thus replaced the son and heir to the role he took. The music for that scene underscored the disappointment and the heartbreak of the characters and its subtle power had moved me so very, very deeply. In closing, as I was leaving the theatre, I took one more look at the poster: \\u0026quot;KOKUHO\\u0026quot; (National Treasure). Yes, the story is about a boy maturing into an artist and becoming a National Treasure, but what is the true National Treasure? The man because of his artistry is only an embodiment of that. In thinking more deeply, I think the true \\u0026quot;National Treasure\\u0026quot; is the art form itself. It is the tradition, the culture and the essence of the art of Kabuki.\",\"__typename\":\"Markdown\"},\"__typename\":\"ReviewText\"},\"title\":{\"id\":\"tt35231039\",\"__typename\":\"Title\"},\"authorRating\":10,\"spoiler\":false,\"__typename\":\"Review\"},\"__typename\":\"ReviewEdge\"},{\"node\":{\"id\":\"rw11145456\",\"author\":{\"userId\":\"ur105652437\",\"username\":{\"text\":\"nicolasroop\",\"__typename\":\"UserProfileUsername\"},\"primaryImage\":null,\"__typename\":\"UserProfile\"},\"summary\":{\"originalText\":\"Very Long, But Worth Every Minute\",\"__typename\":\"ReviewSummary\"},\"text\":{\"originalText\":{\"plaidHtml\":\"It\\u0026#39;s tough to review a movie so deeply rooted in a culture so far from my own. The images on screen, beautiful as they are, don\\u0026#39;t have the same meaning to me as it would for the people the film was made for. I will be the first to admit there are many parts of Japanese culture I don\\u0026#39;t, and probably never will, understand.\\u003cbr/\\u003e\\u003cbr/\\u003eHowever, the beauty of the performances, the care for the story and how it is handled with the utmost sensitivity, made this film pop as much as the Kabuki dances. The way the drama and the plays complimented each other was mesmerizing. Much applause to director Sang-il Lee for balancing that tight rope walk perfectly. It made the length of the film make sense, even when the film dares to slow down it\\u0026#39;s pace and give us some real emotion. My butt may have hurt but my mind was glued to this story.\\u003cbr/\\u003e\\u003cbr/\\u003eThe only reason I cannot give this film a perfect score is because, beautiful as the film is, I never felt the actors were actually feuding. It seemed like they worked together through a lot of the runtime, as opposed to competing for a top spot. It would\\u0026#39;ve been nice to see a bigger, more elaborate quarrel between the two leads. Again, this could also be a cultural misunderstanding on my part. Maybe the quarrel was bigger than it seemed because of the cultural nuances I didn\\u0026#39;t pick up on. So I digress a little on that subject.\\u003cbr/\\u003e\\u003cbr/\\u003eOverall, an excellent film and a right contender for the foreign language Oscar. We\\u0026#39;ll have to wait and see what films get nominated, but if this film is not among the bunch, it would be a crime.\\u003cbr/\\u003e\\u003cbr/\\u003e4.5 Kabuki actors out of 5.\",\"__typename\":\"Markdown\"},\"__typename\":\"ReviewText\"},\"title\":{\"id\":\"tt35231039\",\"__typename\":\"Title\"},\"authorRating\":9,\"spoiler\":false,\"__typename\":\"Review\"},\"__typename\":\"ReviewEdge\"}],\"__typename\":\"ReviewsConnection\"},\"reviewSummary\":null,\"isAdult\":false,\"moreLikeThisTitles\":{\"edges\":[{\"node\":{\"id\":\"tt3595454\",\"titleText\":{\"text\":\"Viva Verdi!\",\"__typename\":\"TitleText\"},\"titleType\":{\"id\":\"movie\",\"text\":\"Movie\",\"canHaveEpisodes\":false,\"displayableProperty\":{\"value\":{\"plainText\":\"\",\"__typename\":\"Markdown\"},\"__typename\":\"DisplayableTitleTypeProperty\"},\"__typename\":\"TitleType\"},\"originalTitleText\":{\"text\":\"Viva Verdi\",\"__typename\":\"TitleText\"},\"primaryImage\":{\"id\":\"rm1862260994\",\"width\":1080,\"height\":1620,\"url\":\"https://m.media-amazon.com/images/M/MV5BYTQxMjZlNmItYmNkZS00ZmI3LTljZjYtYjQxODEyYzcwZDM1XkEyXkFqcGc@._V1_.jpg\",\"caption\":{\"plainText\":\"Viva Verdi! (2024)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"releaseYear\":{\"year\":2024,\"endYear\":null,\"__typename\":\"YearRange\"},\"ratingsSummary\":{\"aggregateRating\":6.2,\"voteCount\":475,\"__typename\":\"RatingsSummary\"},\"runtime\":{\"seconds\":4680,\"__typename\":\"Runtime\"},\"certificate\":null,\"canRate\":{\"isRatable\":true,\"__typename\":\"CanRate\"},\"titleGenres\":{\"genres\":[{\"genre\":{\"text\":\"Documentary\",\"__typename\":\"GenreItem\"},\"__typename\":\"TitleGenre\"},{\"genre\":{\"text\":\"Music\",\"__typename\":\"GenreItem\"},\"__typename\":\"TitleGenre\"}],\"__typename\":\"TitleGenres\"},\"__typename\":\"Title\"},\"__typename\":\"MoreLikeThisEdge\"},{\"node\":{\"id\":\"tt14588692\",\"titleText\":{\"text\":\"Diane Warren: Relentless\",\"__typename\":\"TitleText\"},\"titleType\":{\"id\":\"movie\",\"text\":\"Movie\",\"canHaveEpisodes\":false,\"displayableProperty\":{\"value\":{\"plainText\":\"\",\"__typename\":\"Markdown\"},\"__typename\":\"DisplayableTitleTypeProperty\"},\"__typename\":\"TitleType\"},\"originalTitleText\":{\"text\":\"Diane Warren: Relentless\",\"__typename\":\"TitleText\"},\"primaryImage\":{\"id\":\"rm945200898\",\"width\":1962,\"height\":2898,\"url\":\"https://m.media-amazon.com/images/M/MV5BMTQ3YzZhMjctYTM3MC00YjZhLWE1ZjQtOGRlNjM2OTRmZGE3XkEyXkFqcGc@._V1_.jpg\",\"caption\":{\"plainText\":\"Diane Warren: Relentless (2024)\",\"__typename\":\"Markdo