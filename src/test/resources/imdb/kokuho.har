alse,\"displayableProperty\":{\"value\":{\"plainText\":\"Short\",\"__typename\":\"Markdown\"},\"__typename\":\"DisplayableTitleTypeProperty\"},\"__typename\":\"TitleType\"},\"originalTitleText\":{\"text\":\"The Devil Is Busy\",\"__typename\":\"TitleText\"},\"primaryImage\":{\"id\":\"rm3782191618\",\"width\":768,\"height\":1138,\"url\":\"https://m.media-amazon.com/images/M/MV5BNGM4ZGEzMTQtN2YzMC00NjAzLWJmNjUtY2Y5OTkyM2ZmNDBjXkEyXkFqcGc@._V1_.jpg\",\"caption\":{\"plainText\":\"The Devil Is Busy (2024)\",\"__typename\":\"Markdown\"},\"__typename\":\"Image\"},\"releaseYear\":{\"year\":2024,\"endYear\":null,\"__typename\":\"YearRange\"},\"ratingsSummary\":{\"aggregateRating\":7,\"voteCount\":2173,\"__typename\":\"RatingsSummary\"},\"runtime\":{\"seconds\":1860,\"__typename\":\"Runtime\"},\"certificate\":{\"rating\":\"TV-14\",\"__typename\":\"Certificate\"},\"canRate\":{\"isRatable\":true,\"__typename\":\"CanRate\"},\"titleGenres\":{\"genres\":[{\"genre\":{\"text\":\"Documentary\",\"__typename\":\"GenreItem\"},\"__typename\":\"TitleGenre\"},{\"genre\":{\"text\":\"Short\",\"__typename\":\"GenreItem\"},\"__typename\":\"TitleGenre\"}],\"__typename\":\"TitleGenres\"},\"__typename\":\"Title\"},\"__typename\":\"MoreLikeThisEdge\"}],\"__typename\":\"MoreLikeThisConnection\"},\"relatedInterests\":{\"edges\":[{\"node\":{\"id\":\"in0000224\",\"primaryText\":{\"text\":\"Japanese\",\"__typename\":\"InterestText\"},\"primaryImage\":{\"caption\":{\"plainText\":\"Hidetoshi Nishijima and Tôko Miura in Drive My Car (2021)\",\"__typename\":\"Markdown\"},\"width\":1328,\"height\":885,\"url\":\"https://m.media-amazon.com/images/M/MV5BNGI1MThmNWQtYjM4NC00NTg1LWE5Y2EtM2M4MDVhMDk4MTk2XkEyXkFqcGc@._V1_.jpg\",\"id\":\"rm2849959937\",\"__typename\":\"Image\"},\"visibilityLevel\":\"PUBLIC\",\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"},{\"node\":{\"id\":\"in0000076\",\"primaryText\":{\"text\":\"Drama\",\"__typename\":\"InterestText\"},\"primaryImage\":{\"caption\":{\"plainText\":\"Naomie Harris, Mahershala Ali, Janelle Monáe, André Holland, Herman Caheej McGloun, Edson Jean, Alex R. Hibbert, and Tanisha Cidel in Moonlight (2016)\",\"__typename\":\"Markdown\"},\"width\":5760,\"height\":3840,\"url\":\"https://m.media-amazon.com/images/M/MV5BN2MxZmYzMDItYzNkMS00YWY1LWIzNDktNTI3YTQxMGNjZjEzXkEyXkFqcGc@._V1_.jpg\",\"id\":\"rm1359216640\",\"__typename\":\"Image\"},\"visibilityLevel\":\"PUBLIC\",\"__typename\":\"Interest\"},\"__typename\":\"InterestEdge\"}],\"__typename\":\"InterestConnection\"},\"triviaTotal\":{\"total\":4,\"__typename\":\"TriviaConnection\"},\"trivia\":{\"edges\":[{\"node\":{\"text\":{\"plaidHtml\":\"The novel\\u0026#39;s author, Shuichi Yoshida, devoted immense time to research by spending an unprecedented three years working backstage as a Kurogo (a stagehand dressed in black to signify being \\u0026#39;invisible\\u0026#39;). This deep, firsthand experience in the actors\\u0026#39; dressing rooms and on stage is what gave the novel, and consequently the film, its profound authenticity regarding the Kabuki world.\",\"__typename\":\"Markdown\"},\"trademark\":null,\"relatedNames\":null,\"__typename\":\"TitleTrivia\"},\"__typename\":\"TriviaEdge\"}],\"__typename\":\"TriviaConnection\"},\"goofsTotal\":{\"total\":0,\"__typename\":\"GoofConnection\"},\"goofs\":{\"edges\":[],\"__typename\":\"GoofConnection\"},\"quotesTotal\":{\"total\":1,\"__typename\":\"TitleQuoteConnection\"},\"quotes\":{\"edges\":[{\"node\":{\"lines\":[{\"characters\":[{\"character\":\"Hanjiro Hanai\",\"name\":{\"id\":\"nm0913822\",\"__typename\":\"Name\"},\"__typename\":\"TitleQuoteCharacter\"}],\"text\":\"You were born into a family of actors so your family blood will always protect you.\",\"stageDirection\":null,\"__typename\":\"TitleQuoteLine\"}],\"__typename\":\"TitleQuote\"},\"__typename\":\"TitleQuoteEdge\"}],\"__typename\":\"TitleQuoteConnection\"},\"crazyCredits\":{\"edges\":[],\"__typename\":\"CrazyCreditConnection\"},\"alternateVersions\":{\"total\":0,\"edg