i/5262707._UX200_CR0,2,200,200_.jpg\",\"readingChallengeUrl\":\"https://www.goodreads.com/readingchallenges\",\"navigationQuickLinks\":[{\"__typename\":\"NavigationQuickLink\",\"webUrl\":\"/comment/list/5262707\",\"pageType\":\"COMMENTS\"},{\"__typename\":\"NavigationQuickLink\",\"webUrl\":\"/group/list/5262707\",\"pageType\":\"GROUPS\"},{\"__typename\":\"NavigationQuickLink\",\"webUrl\":\"/user/show/5262707\",\"pageType\":\"PROFILE\"},{\"__typename\":\"NavigationQuickLink\",\"webUrl\":\"/review/list/5262707\",\"pageType\":\"MYBOOKS\"}],\"isAuthor\":false,\"contributor\":null,\"textReviewsCount\":7,\"followersCount\":5,\"favoriteGenres\":{\"__typename\":\"UserGenresConnection\",\"totalCount\":19,\"edges\":[{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.SwbkUdVF0Kuh-Zelb-rg8w\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.SaDW7jwCeVzT03cH6exvBQ\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.ymRoTxBdcCu4YXuzz4LHSg\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.onbrwWRkAbZ-humriHmROQ\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1._FBk7hF_dB_wAcxl1FJDag\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.IXB27x7PO6V20Hj2WOL0Tg\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.EeaAdkKcj6oQuAiSJwBIng\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.nukwECM-9AS0Bw60eptT-g\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.Ar8JC0xMtwjmxkWtAICAKw\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.AScoppayJv0By7B_ggewmQ\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.v4Feau4ZXqP3SjBuIl12WA\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.GF40UQIZF7M-_QlM9nNChw\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.Mo-tm8U0_0izAs_5CY6sFg\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.p-kdkuFfU6my4LXH0_uuRA\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.6LL5UOytXCkpXxd1WkGyOg\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.aeBS7B6iLcHBK_-eguatHA\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.iVKtv9MAOFnwRNPRivQlXw\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.zvMrKxq1qcr6uZkUSH9CCg\"}},{\"__typename\":\"UserGenreEdge\",\"node\":{\"__ref\":\"Genre:kca://genre/amzn1.gr.genre.v1.7sOfd-tCcoyOrlTQ2AyOTw\"}}]},\"webUrl\":\"https://www.goodreads.com/user/show/5262707-thebestpessimist\",\"viewerNotificationsUnreadCount\":0,\"viewerMessagesUnreadCount\":0,\"viewerFriendRequestsUnreadCount\":0,\"id\":5262707},\"Book:kca://book/amzn1.gr.book.v1.SxhF43k9mOl9I8rt6i8aCw\":{\"__typename\":\"Book\",\"id\":\"kca://book/amzn1.gr.book.v1.SxhF43k9mOl9I8rt6i8aCw\",\"legacyId\":27761090,\"webUrl\":\"https://www.goodreads.com/book/show/27761090-ghost-in-the-cogs\",\"viewerShelving\":{\"__ref\":\"Shelving:kca://profile:goodreads/A2UGLXY4CWY0BX|kca://book/amzn1.gr.book.v1.SxhF43k9mOl9I8rt6i8aCw\"},\"title\":\"Ghost in the Cogs: Steam-Powered Ghost Stories\",\"titleComplete\":\"Ghost in the Cogs: Steam-Powered Ghost Stories\",\"description\":\"Ghosts. Gaslight. Gears. \\u003cbr /\\u003e\\u003cbr /\\u003eAnd incredible authors: Siobhan Carroll, Folly Blaine \\u0026amp; Randy Henderson, Jessica Corra, Howard Andrew Jones, Emily C. Skaftun, Elsa S. Henry, Eddy Webb, Nayad Monroe, Jonah Buck, Erika Holt, Wendy Nikel, Parker Goodreau, Christopher Paul Carey, T. Mike McCurley, Scott Fitzgerald Gray, Richard Dansky, Nick Mamatas, Spencer Ellsworth, Liane Merciel, Richard Pett, James Lowder, Cat Hellisen. \\u003cbr /\\u003e\\u003cbr /\\u003eWelcome to a wondrous age of steam where pirates, rust, and syphilis aren't all you need to worry about. Ghosts abound! \\u003cbr /\\u003e\\u003cbr /\\u003eIn this hissing and clanking steampunk anthology, there are moments that science just can't explain. All the mechanical geniuses scratch their heads and whisper words of ghosts and powers, of spirits and demons. Possessed automatons take on lives of their own. Superstitious pilots take all necessary precautions. Avant-garde machinists harness the spirits to power their creations. Revenge-minded ghosts stalk haunted gasworks. This is a mechanized playground for the souls of the dead. \\u003cbr /\\u003e\\u003cbr /\\u003eAgain and again, the spirit world proves itself inspiring and dangerous, useful and annoying. In rich steampunk worlds, chock full of gizmos and gadgets aplenty, these are the stories that go bump, clatter, boom in the night.\",\"description({\\\"stripped\\\":true})\":\"Ghosts. Gaslight. Gears. \\r\\n\\r\\nAnd incredible authors: Siobhan Carroll, Folly Blaine \\u0026 Randy Henderson, Jessica Corra, Howard Andrew Jones, Emily C. Skaftun, Elsa S. Henry, Eddy Webb, Nayad Monroe, Jonah Buck, Erika Holt, Wendy Nikel, Parker Goodreau, Christopher Paul Carey, T. Mike McCurley, Scott Fitzgerald Gray, Richard Dansky, Nick Mamatas, Spencer Ellsworth, Liane Merciel, Richard Pett, James Lowder, Cat Hellisen. \\r\\n\\r\\nWelcome to a wondrous age of steam where pirates, rust, and syphilis aren't all you need to worry about. Ghosts abound! \\r\\n\\r\\nIn this hissing and clanking steampunk anthology, there are moments that science just can't explain. All the mechanical geniuses scratch their heads and whisper words of ghosts and powers, of spirits and demons. Possessed automatons take on lives of their own. Superstitious pilots take all necessary precautions. Avant-garde machinists harness the spirits to power their creations. Revenge-minded ghosts stalk haunted gasworks. This is a mechanized playground for the souls of the dead. \\r\\n\\r\\nAgain and again, the spirit world proves itself inspiring and dangerous, useful and annoying. In rich steampunk worlds, chock full of gizmos and gadgets aplenty, these are the stories that go bump, clatter, boom in the night.\",\"primaryContributorEdge\":{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.j-S7nS8oIOs1TN2K6ZfDeQ\"},\"role\":\"Editor\"},\"secondaryContributorEdges\":[{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.AAMjcexTSqMzHxtPHHA7qQ\"},\"role\":\"Editor\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.EcDQnfOBa1RszKr-6MjpPA\"},\"role\":\"Author\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.4ehxWBVFrYF2mBLggwboRA\"},\"role\":\"Author\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.-JArXUqBZ1pujD44tu-Isg\"},\"role\":\"Author\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.wNWy5bRuv7nzYiQD1J8qTA\"},\"role\":\"Author\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.d2KnG_2A0OGj3kYwBvHpsg\"},\"role\":\"Author\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.C-ePpTZPyzy3gXzUwrV75Q\"},\"role\":\"Author\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.author.v1.eYGDuDoh2wUX18jX5rWxCw\"},\"role\":\"Author\"},{\"__typename\":\"BookContributorEdge\",\"node\":{\"__ref\":\"Contributor:kca://author/amzn1.gr.autho