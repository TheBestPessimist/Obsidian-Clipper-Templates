ent BasicBookFragment on Book {\\n  id\\n  legacyId\\n  imageUrl\\n  description\\n  title\\n  titleComplete\\n  webUrl\\n  __typename\\n}\\n\\nfragment BookPageDetails on BookDetails {\\n  asin\\n  format\\n  numPages\\n  publicationTime\\n  publisher\\n  isbn\\n  isbn13\\n  language {\\n    name\\n    __typename\\n  }\\n  __typename\\n}\"}"}},"response":{"status":200,"statusText":"","httpVersion":"http/2.0","headers":[{"name":"access-control-allow-origin","value":"*"},{"name":"access-control-expose-headers","value":"x-amzn-RequestId,x-amzn-ErrorType,x-amz-user-agent,x-amzn-ErrorMessage,Date,x-amz-schema-version"},{"name":"content-encoding","value":"gzip"},{"name":"content-type","value":"application/json; charset=UTF-8"},{"name":"date","value":"Sun, 12 Jul 2026 12:05:20 GMT"},{"name":"vary","value":"Accept-Encoding"},{"name":"via","value":"1.1 b62c906078644edd3439e2d986abd2e2.cloudfront.net (CloudFront)"},{"name":"x-amz-cf-id","value":"DzMQXjg_eO9_EVDJCVKThbw6hbvbbC8Vbur9Zg1bv5sWPZS1QgGvtw=="},{"name":"x-amz-cf-pop","value":"OTP50-P3"},{"name":"x-amzn-appsync-tokensconsumed","value":"1"},{"name":"x-amzn-requestid","value":"45aab00a-5b99-4731-8cde-e6ad71b10e26"},{"name":"x-cache","value":"Miss from cloudfront"}],"cookies":[],"content":{"size":2263,"mimeType":"application/json","text":"{\"data\":{\"getBook\":{\"id\":\"kca://book/amzn1.gr.book.v1.SxhF43k9mOl9I8rt6i8aCw\",\"legacyId\":27761090,\"imageUrl\":\"https://m.media-amazon.com/images/S/compressed.photo.goodreads.com/books/1448045410i/27761090.jpg\",\"description\":\"Ghosts. Gaslight. Gears. <br /><br />And incredible authors: Siobhan Carroll, Folly Blaine &amp; Randy Henderson, Jessica Corra, Howard Andrew Jones, Emily C. Skaftun, Elsa S. Henry, Eddy Webb, Nayad Monroe, Jonah Buck, Erika Holt, Wendy Nikel, Parker Goodreau, Christopher Paul Carey, T. Mike McCurley, Scott Fitzgerald Gray, Richard Dansky, Nick Mamatas, Spencer Ellsworth, Liane Merciel, Richard Pett, James Lowder, Cat Hellisen. <br /><br />Welcome to a wondrous age of steam where pirates, rust, and syphilis aren't all you need to worry about. Ghosts abound! <br /><br />In this hissing and clanking steampunk anthology, there are moments that science just can't explain. All the mechanical geniuses scratch their heads and whisper words of ghosts and powers, of spirits and demons. Possessed automatons take on lives of their own. Superstitious pilots take all necessary precautions. Avant-garde machinists harness the spirits to power their creations. Revenge-minded ghosts stalk haunted gasworks. This is a mechanized playground for the souls of the dead. <br /><br />Again and again, the spirit world proves itself inspiring and dangerous, useful and annoying. In rich steampunk worlds, chock full of gizmos and gadgets aplenty, these are the stories that go bump, clatter, boom in the night.\",\"title\":\"Ghost in the Cogs: Steam-Powered Ghost Stories\",\"titleComplete\":\"Ghost in the Cogs: Steam-Powered Ghost Stories\",\"webUrl\":\"https://www.goodreads.com/book/show/27761090-ghost-in-the-cogs\",\"__typename\":\"Book\",\"reviewEditUrl\":\"https://www.goodreads.com/review/edit/27761090\",\"details\":{\"asin\":\"1940372143\",\"format\":\"Paperback\",\"numPages\":250,\"publicationTime\":1.4462748E12,\"publisher\":\"Broken Eye Books\",\"isbn\":\"1940372143\",\"isbn13\":\"9781940372143\",\"language\":{\"name\":\"English\",\"__typename\":\"Language\"},\"__typename\":\"BookDetails\"},\"work\":{\"id\":\"kca://work/amzn1.gr.work.v1.xAc7P8ynCpn3Wbpzfj2KLQ\",\"__typename\":\"Work\"},\"featureFlags\":{\"noNewRatings\":false,\"noNewTextReviews\":false,\"noReviews\":false,\"__typename\":\"FeatureFlags\"}}}}"},"redirectURL":"","headersSize":-1,"bodySize":-1,"_transferSize":2155,"_error":null,"_fetchedViaServiceWorker":false},"serverIPAddress":"143.204.11.100","startedDateTime":"2026-07-12T12:05:19.618Z","time":542.5329999998212,"timings":{"blocked":152.29000000248664,"dns":-1,"ssl":-1,"connect":-1,"send":0.20899999999999963,"wait":3